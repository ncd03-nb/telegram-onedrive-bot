{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"telegram-bot-failover",
  "main":"src/index.mjs",
  "compatibility_date":"2026-08-01",
  "workers_dev":true,
  "durable_objects":{"bindings":[{"name":"BOT_STATE","class_name":"BotState"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["BotState"]}],
  "observability":{"enabled":true},
  "secrets":{"required":["BOTS_CONFIG"]}
}
