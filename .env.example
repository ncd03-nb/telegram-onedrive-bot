# Bot mới tạo bằng @BotFather; không dùng token bot ROM hiện tại.
TELEGRAM_BOT_TOKEN=123456789:replace_with_BotFather_token
# Lấy user ID bằng scripts/telegram_identity.py trước khi chạy bot.
ALLOWED_USER_IDS=123456789
BOT_MODE=polling
TRANSFER_BACKEND=actions
ACTIONS_REPO=ncd03-nb/telegram-onedrive-bot
ACTIONS_REF=main
# Fine-grained PAT chỉ repo bot, quyền Actions read/write (không gửi token vào chat).
ACTIONS_DISPATCH_TOKEN=
PORT=8080
HOST_PORT=8081
DATA_DIR=/data
RCLONE_CONFIG=/config/rclone.conf
GOOGLE_TOKEN_PATH=/config/google-token.json
ONEDRIVE_DEST=onedrive:TelegramUploads
# HTTPS origin for readable, signed download links. Empty disables custom links.
DOWNLOAD_BASE_URL=https://telegram-onedrive-standby.onrender.com
# 12 GiB đủ cho một file khoảng 10 GB; tối đa một transfer cùng lúc.
MAX_FILE_GIB=12
# Link không báo dung lượng: cho lưu tạm tối đa 512 MiB; đặt 0 để tắt.
MAX_SPOOL_MIB=512
TRANSFER_TIMEOUT_SECONDS=21600
RETENTION_HOURS=12
CLEANUP_INTERVAL_SECONDS=60
# Backend local; runner Actions dùng 50 MiB để giảm số lượt upload chunk.
ONEDRIVE_CHUNK_MIB=10
ONEDRIVE_DISABLE_HTTP2=true
SOURCE_PREFETCH_MIB=64
# Chỉ dùng cho BOT_MODE=webhook.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Chỉ dùng trên host không có volume; Base64 là bí mật, không phải mã hóa.
RCLONE_CONFIG_B64=
GOOGLE_TOKEN_B64=
